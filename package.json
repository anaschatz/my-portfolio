{
  "name": "anastasis-engineering-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static engineering portfolio for Anastasis Chatzidakis.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "html-validate index.html && node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "html-validate": "^10.17.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6"
  }
}
